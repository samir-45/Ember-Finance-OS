{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f6f3f1" },
      "foreground": { "$value": "#211d1a" },
      "border": { "$value": "#e5d8d3" },
      "card": { "$value": "#fffaf7" },
      "cardForeground": { "$value": "#211d1a" },
      "popover": { "$value": "#fffaf7" },
      "popoverForeground": { "$value": "#211d1a" },
      "primary": {
        "$value": "#c72d1d",
        "$description": "Ember red for primary actions and high-value emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#f0e5df" },
      "secondaryForeground": { "$value": "#30211c" },
      "muted": { "$value": "#efe9e5" },
      "mutedForeground": { "$value": "#685e58" },
      "accent": { "$value": "#7a0a0a" },
      "accentForeground": { "$value": "#fff8f5" },
      "destructive": { "$value": "#b42318" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#dfd2cc" },
      "ring": { "$value": "#c72d1d" },
      "chart1": { "$value": "#c72d1d" },
      "chart2": { "$value": "#277a50" },
      "chart3": { "$value": "#bd6b1c" },
      "chart4": { "$value": "#8155a5" },
      "chart5": { "$value": "#9f5265" },
      "sidebar": { "$value": "#f2ece8" },
      "sidebarForeground": { "$value": "#302824" },
      "sidebarBorder": { "$value": "#e5d8d3" },
      "sidebarPrimary": { "$value": "#c72d1d" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#e9d8d0" },
      "sidebarAccentForeground": { "$value": "#30211c" },
      "sidebarRing": { "$value": "#c72d1d" }
    },
    "dark": {
      "background": { "$value": "#050505" },
      "foreground": { "$value": "#f6f1ee" },
      "border": { "$value": "#302522" },
      "card": { "$value": "#11100f" },
      "cardForeground": { "$value": "#f6f1ee" },
      "popover": { "$value": "#12100f" },
      "popoverForeground": { "$value": "#f6f1ee" },
      "primary": {
        "$value": "#ff3b1f",
        "$description": "Signature ember red for primary actions and focused emphasis."
      },
      "primaryForeground": { "$value": "#210904" },
      "secondary": { "$value": "#1b1715" },
      "secondaryForeground": { "$value": "#eee7e2" },
      "muted": { "$value": "#171514" },
      "mutedForeground": { "$value": "#b2a7a1" },
      "accent": { "$value": "#7a0a0a" },
      "accentForeground": { "$value": "#fff8f5" },
      "destructive": { "$value": "#e04435" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#352722" },
      "ring": { "$value": "#ff6a2b" },
      "chart1": { "$value": "#ff3b1f" },
      "chart2": { "$value": "#7ad9a0" },
      "chart3": { "$value": "#ffac58" },
      "chart4": { "$value": "#cf85ff" },
      "chart5": { "$value": "#b9bfd4" },
      "sidebar": { "$value": "#080707" },
      "sidebarForeground": { "$value": "#eae1dc" },
      "sidebarBorder": { "$value": "#261d1a" },
      "sidebarPrimary": { "$value": "#ff3b1f" },
      "sidebarPrimaryForeground": { "$value": "#210904" },
      "sidebarAccent": { "$value": "#1c1715" },
      "sidebarAccentForeground": { "$value": "#f6f1ee" },
      "sidebarRing": { "$value": "#ff6a2b" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Geist", "Inter", "sans-serif"],
        "$description": "Default UI and body face; use tabular numerals for money."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Cards use a 16px extra-large radius; smaller controls derive from this base."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
