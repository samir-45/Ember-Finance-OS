# All finance pages require owner sign-in, locally and after deployment.
# Set a unique random owner password of at least 16 characters.
EMBER_OWNER_PASSWORD=
# Independent random secret, at least 32 characters.
EMBER_SESSION_SECRET=
EMBER_PUBLIC_URL=http://localhost:3000
# Optional passkey relying-party ID. Leave blank to use EMBER_PUBLIC_URL's hostname.
# EMBER_WEBAUTHN_RP_ID=example.com

# PostgreSQL is the default server storage when DATABASE_URL is configured.
# Apply the additive migration before connecting. Use a verified TLS connection.
DATABASE_URL=

# Alternative for a single persistent Node host only; never an automatic fallback.
# EMBER_STORAGE_DRIVER=file
# EMBER_VAULT_PATH=/absolute/durable/path/ember-vault.json

# Optional AI quick entry. Leave the key empty to turn it off on this server; the
# owner must also switch it on in Settings before any text is sent to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
