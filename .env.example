# Browser-only mode works without server credentials.
# Set a unique random owner password of at least 16 characters before enabling sync.
EMBER_OWNER_PASSWORD=
EMBER_SESSION_SECRET=
EMBER_PUBLIC_URL=http://localhost:3000

# Set only after an explicitly authorized full reset. A new UUID clears each
# browser's Ember records/recovery/demo storage once on its next online load.
# EMBER_WORKSPACE_RESET_GENERATION=

# PostgreSQL is the default server storage when DATABASE_URL is configured.
# Apply the additive migration before connecting. Use a verified TLS connection.
DATABASE_URL=

# Alternative for a single persistent Node host only; never an automatic fallback.
# EMBER_STORAGE_DRIVER=file
# EMBER_VAULT_PATH=/absolute/durable/path/ember-vault.json

# External AI requires both this allow switch and explicit per-user sharing consent.
EMBER_ENABLE_EXTERNAL_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
