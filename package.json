{
  "name": "ember-finance-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts --max-warnings=0 && tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts playwright.config.ts eslint.config.mjs next.config.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate-ledger.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
